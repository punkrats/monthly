<?xml version="1.0" encoding="utf-8"?>
<!-- Calendar and cycle data stay off cloud backups; a phone-to-phone
     transfer keeps them. Export to .ics for a manual backup. -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
  </cloud-backup>
  <device-transfer>
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
  </device-transfer>
</data-extraction-rules>
